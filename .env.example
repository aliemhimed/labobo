# Copy to .env for `npm run dev:netlify` (netlify dev). Never commit .env.

# Required for the functions to save quiz results, question reports and
# leaderboard entries. Supabase dashboard -> Project Settings -> API keys ->
# service_role (secret). Without it those writes fail with a 500 and the
# function log says "SUPA_SERVICE_KEY is not set".
SUPA_SERVICE_KEY=

# Optional overrides; the functions default to the production project.
# SUPA_URL=https://boukmowybmtfqkinuvqj.supabase.co
# SUPA_KEY=sb_publishable_...
